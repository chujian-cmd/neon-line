<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<title>伪 AR - 视频透视 + 姿态追踪</title>
<style>
  html,body{margin:0;height:100%;overflow:hidden;background:#000;}
  #video{position:fixed;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;}
  #canvas{position:fixed;inset:0;width:100%;height:100%;z-index:1;}
  #hud{position:fixed;left:8px;top:8px;z-index:2;color:#0f0;
       font:12px monospace;background:rgba(0,0,0,.5);padding:6px;border-radius:6px;
       max-width:90vw;word-break:break-all;}
  #start{position:fixed;inset:0;z-index:3;display:flex;align-items:center;
         justify-content:center;background:#000;color:#0f0;font:16px monospace;
         cursor:pointer;}
</style>
</head>
<body>
<video id="video" playsinline muted autoplay></video>
<canvas id="canvas"></canvas>
<div id="hud">等待开始…</div>
<div id="start">点击开始伪 AR</div>

<script type="importmap">
{ "imports": { "three": "https://unpkg.com/three@0.160.0/build/three.module.js" } }
</script>

<script type="module">
import * as THREE from 'three';

const video = document.getElementById('video');
const canvas = document.getElementById('canvas');
const hud = document.getElementById('hud');
const startBtn = document.getElementById('start');

// ---------- 状态 ----------
const state = {
  quat: new THREE.Quaternion(),
  accel: new THREE.Vector3(),
  gravity: new THREE.Vector3(0, -1, 0),
  hasOrientation: false,
  screenAngle: 0,
  alphaOffset: null,   // 锁定初始方位，避免绝对方位跳变
};

// ---------- 姿态 ----------
function onOrientation(e) {
  const alpha = e.alpha ?? 0;
  const beta  = e.beta  ?? 0;
  const gamma = e.gamma ?? 0;

  if (state.alphaOffset === null) state.alphaOffset = alpha;
  const a = alpha - state.alphaOffset;

  // YXZ：先绕 Y(yaw) 再绕 X(pitch)，roll 用 -gamma
  const euler = new THREE.Euler(
    THREE.MathUtils.degToRad(beta),
    THREE.MathUtils.degToRad(a),
    THREE.MathUtils.degToRad(-gamma),
    'YXZ'
  );
  const q = new THREE.Quaternion().setFromEuler(euler);

  // 屏幕旋转补偿
  const screenQ = new THREE.Quaternion().setFromAxisAngle(
    new THREE.Vector3(0, 0, 1),
    THREE.MathUtils.degToRad(-state.screenAngle)
  );
  q.multiply(screenQ);

  state.quat.copy(q);
  state.hasOrientation = true;
}

function onMotion(e) {
  const a = e.accelerationIncludingGravity;
  if (a) {
    state.accel.set(a.x || 0, a.y || 0, a.z || 0);
    state.gravity.lerp(state.accel.clone().normalize(), 0.15);
  }
}

// 只修 pitch/roll，绝不动 yaw，避免持续自转
function correctDrift(q) {
  const e = new THREE.Euler().setFromQuaternion(q, 'YXZ');
  e.x *= 0.98;
  e.z *= 0.98;
  // e.y 保持不变
  return new THREE.Quaternion().setFromEuler(e);
}

// ---------- 摄像头 ----------
async function startCamera() {
  const stream = await navigator.mediaDevices.getUserMedia({
    video: {
      facingMode: { ideal: 'environment' },
      width: { ideal: 1280 },
      height: { ideal: 720 }
    },
    audio: false
  });
  video.srcObject = stream;
  await video.play();
}

// ---------- Three.js ----------
const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.setSize(innerWidth, innerHeight);

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(70, innerWidth / innerHeight, 0.01, 100);

const cube = new THREE.Mesh(
  new THREE.BoxGeometry(0.3, 0.3, 0.3),
  new THREE.MeshStandardMaterial({
    color: 0x00ffcc, emissive: 0x00ffcc, emissiveIntensity: 2
  })
);
cube.position.set(0, 0, -2);
scene.add(cube);

const grid = new THREE.GridHelper(20, 40, 0x00ffcc, 0x004444);
grid.position.y = -1.5;
scene.add(grid);

scene.add(new THREE.HemisphereLight(0xffffff, 0x222222, 2));
const dir = new THREE.DirectionalLight(0xffffff, 1);
dir.position.set(0, 1, 0);
scene.add(dir);

// 设备坐标系 -> Three 相机坐标系
const deviceToCam = new THREE.Quaternion().setFromEuler(
  new THREE.Euler(-Math.PI / 2, 0, 0, 'XYZ')
);

// ---------- 主循环 ----------
function tick() {
  requestAnimationFrame(tick);

  if (state.hasOrientation) {
    const q = correctDrift(state.quat);
    camera.quaternion.copy(deviceToCam.clone().multiply(q));
  }

  cube.rotation.y += 0.01;
  cube.rotation.x += 0.005;

  renderer.render(scene, camera);

  hud.textContent =
    `姿态:${state.hasOrientation ? 'OK' : '等待'} ` +
    `g:${state.gravity.x.toFixed(2)},${state.gravity.y.toFixed(2)},${state.gravity.z.toFixed(2)}`;
}
requestAnimationFrame(tick);

// ---------- 启动（拆两步授权） ----------
startBtn.addEventListener('click', async () => {
  startBtn.style.display = 'none';

  hud.textContent =
    `secure=${window.isSecureContext} ` +
    `media=${!!navigator.mediaDevices} ` +
    `gum=${navigator.mediaDevices?.getUserMedia ? 'yes' : 'no'}`;

  // 1. 摄像头
  try {
    await startCamera();
    hud.textContent = '摄像头 OK，请求传感器…';
  } catch (e) {
    hud.textContent = '摄像头失败: ' + e.name + ' / ' + e.message;
    startBtn.style.display = 'flex';
    startBtn.textContent = '重试';
    return;
  }

  // 2. 传感器权限
  try {
    if (typeof DeviceOrientationEvent !== 'undefined' &&
        typeof DeviceOrientationEvent.requestPermission === 'function') {
      const p = await DeviceOrientationEvent.requestPermission();
      if (p !== 'granted') throw new Error('姿态权限被拒');
    }
    if (typeof DeviceMotionEvent !== 'undefined' &&
        typeof DeviceMotionEvent.requestPermission === 'function') {
      await DeviceMotionEvent.requestPermission();
    }
  } catch (e) {
    hud.textContent = '传感器失败: ' + e.message;
    return;
  }

  window.addEventListener('deviceorientation', onOrientation, true);
  window.addEventListener('devicemotion', onMotion, true);

  state.screenAngle = screen.orientation?.angle ?? window.orientation ?? 0;
  window.addEventListener('orientationchange', () => {
    state.screenAngle = screen.orientation?.angle ?? window.orientation ?? 0;
  });

  hud.textContent = '运行中';
});

addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});
</script>
</body>
</html>