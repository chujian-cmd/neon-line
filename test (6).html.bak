<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Three.js WebXR AR 命中测试 - 成功版</title>
    <style>
        body { margin: 0; overflow: hidden; font-family: sans-serif; }
        #info {
            position: absolute; top: 20px; left: 20px;
            background: rgba(0,0,0,0.7); color: white;
            padding: 12px 24px; border-radius: 30px;
            z-index: 100; pointer-events: none;
        }
        #info span { color: #ff4d4d; font-weight: bold; }
    </style>
</head>
<body>
    <div id="info"><span>⚡ AR 命中测试</span> | 半透明红色平面</div>

    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.128.0/build/three.module.js",
                "three/addons/": "https://unpkg.com/three@0.128.0/examples/jsm/"
            }
        }
    </script>

    <script type="module">
        import * as THREE from 'three';
        import { ARButton } from 'three/addons/webxr/ARButton.js';

        // 1. 初始化
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.01, 20);
        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(window.devicePixelRatio);
        renderer.xr.enabled = true;
        document.body.appendChild(renderer.domElement);

        // 2. 半透明红色平面
        const geometry = new THREE.PlaneGeometry(0.5, 0.5);
        const material = new THREE.MeshBasicMaterial({
            color: 0xff0000, transparent: true, opacity: 0.5,
            side: THREE.DoubleSide, depthWrite: false
        });
        const redPlane = new THREE.Mesh(geometry, material);
        redPlane.visible = false;
        scene.add(redPlane);

        // 3. 官方 ARButton，带上 hit-test 和 anchors
        document.body.appendChild(ARButton.createButton(renderer, {
            requiredFeatures: ['hit-test', 'anchors'],
            optionalFeatures: ['dom-overlay'],
            domOverlay: { root: document.body }
        }));

        // 4. 会话状态
        let hitTestSource = null;
        let referenceSpace = null;

        renderer.xr.addEventListener('sessionstart', async () => {
            const session = renderer.xr.getSession();
            referenceSpace = renderer.xr.getReferenceSpace();
            const viewerSpace = await session.requestReferenceSpace('viewer');
            hitTestSource = await session.requestHitTestSource({ space: viewerSpace });
        });

        // 5. 每帧命中检测
        renderer.setAnimationLoop((timestamp, frame) => {
            if (!frame) return;
            if (hitTestSource && referenceSpace) {
                const results = frame.getHitTestResults(hitTestSource);
                if (results.length > 0) {
                    const pose = results[0].getPose(referenceSpace);
                    if (pose) {
                        const pos = new THREE.Vector3();
                        const quat = new THREE.Quaternion();
                        new THREE.Matrix4().fromArray(pose.transform.matrix).decompose(pos, quat, new THREE.Vector3());
                        redPlane.position.copy(pos);
                        const normal = new THREE.Vector3(0, 1, 0).applyQuaternion(quat);
                        redPlane.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), normal);
                        redPlane.visible = true;
                    }
                } else {
                    redPlane.visible = false;
                }
            }
            renderer.render(scene, camera);
        });

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>